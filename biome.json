{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "plugins": ["./biome-plugins/no-raw-datetime-format.grit"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/vite.config.ts",
      "!packages/shared/config/**",
      "!**/dist/**",
      "!**/build/**",
      "!**/.turbo/**",
      "!**/coverage/**",
      "!**/assets/**",
      "!**/locales/**",
      "!**/public/**",
      "!**/*.lock",
      "!**/*.min.js",
      "!**/*.min.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 120,
      "quoteStyle": "double"
    },
    "linter": {
      "enabled": true
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "double",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "arrowParentheses": "always"
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "suspicious": {
        "noExplicitAny": "warn",
        "noDebugger": "error",
        "noArrayIndexKey": "warn",
        "noConsole": {
          "level": "warn",
          "fix": "none"
        }
      },
      "correctness": {
        "noUnusedImports": {
          "level": "warn",
          "fix": "safe"
        },
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": {
          "level": "warn",
          "fix": "none"
        }
      },
      "style": {
        "useImportType": "warn"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {
            "attributes": ["className", "class"],
            "functions": ["cn", "cva", "clsx"]
          }
        }
      }
    },
    "domains": {
      "react": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ["react", "react-*", "react-*/**"],
              ":BLANK_LINE:",
              [":PACKAGE:", "!@aixera/**", "!@/**"],
              ":BLANK_LINE:",
              "@aixera/**",
              ":BLANK_LINE:",
              "@/**",
              ":BLANK_LINE:",
              ["./**", "../**"]
            ]
          }
        }
      }
    }
  }
}
